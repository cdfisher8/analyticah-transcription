# Template only. Keep real credentials in approved secret storage, never Git.
# New API keys are provisioned through secure setup, not pasted into frontend files.
OPENAI_API_KEY=
# Separate app access code: at least 24 unpredictable characters. Not the API key.
UPLOAD_ACCESS_CODE=
ENABLE_UPLOADS=false
TRANSCRIPTION_MODEL=gpt-transcribe
ALLOWED_ORIGINS=https://transcribe.analyticah.co.za,http://localhost:8787
MAX_AUDIO_SECONDS=1800
# Process-local precaution, not a durable billing/spending cap.
MAX_DAILY_AUDIO_SECONDS=3600
HOST=127.0.0.1
PORT=8787
